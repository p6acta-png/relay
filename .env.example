# Relay environment template.
# `npm run setup` copies this to .env and replaces every CHANGE_ME value with a random secret.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# The running app connects as a restricted role: not the table owner, cannot bypass
# row-level security. See ARCHITECTURE.md → "Tenant isolation".
DATABASE_URL="postgresql://relay_app:CHANGE_ME_APP_PASSWORD@localhost:54329/relay"
# Migrations, seeding helpers and Prisma Studio use the owner role.
DATABASE_OWNER_URL="postgresql://relay_owner:CHANGE_ME_OWNER_PASSWORD@localhost:54329/relay"

# Separate databases so tests never touch your demo data.
TEST_DATABASE_URL="postgresql://relay_app:CHANGE_ME_APP_PASSWORD@localhost:54329/relay_test"
TEST_DATABASE_OWNER_URL="postgresql://relay_owner:CHANGE_ME_OWNER_PASSWORD@localhost:54329/relay_test"
E2E_DATABASE_URL="postgresql://relay_app:CHANGE_ME_APP_PASSWORD@localhost:54329/relay_e2e"
E2E_DATABASE_OWNER_URL="postgresql://relay_owner:CHANGE_ME_OWNER_PASSWORD@localhost:54329/relay_e2e"

# Superuser password for the local cluster only (used by scripts/db.mjs to create roles).
LOCAL_PG_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# --- Application --------------------------------------------------------------
APP_URL="http://localhost:3000"
# Used to HMAC-hash IP addresses for rate limiting, so raw IPs are never stored.
APP_SECRET="CHANGE_ME_APP_SECRET"
# Only set to true behind a reverse proxy you control; otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY_HEADERS="false"
# Shows demo credentials on the login page and "Demo mode" labels on simulated integrations.
DEMO_MODE="true"

# --- Providers (see ARCHITECTURE.md → "Provider boundaries") ------------------
# mock = deterministic built-in demo AI. No other provider is wired up in this build.
AI_PROVIDER="mock"
# demo = emails are written to the in-app outbox instead of being sent.
EMAIL_PROVIDER="demo"
# demo = honeypot + timing checks instead of a third-party CAPTCHA.
CHALLENGE_PROVIDER="demo"

# --- Tooling --------------------------------------------------------------------
# Prisma's update notice currently points at a release candidate; versions are pinned on purpose.
PRISMA_HIDE_UPDATE_MESSAGE="true"
