{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay turns repetitive customer conversations into structured actions for small businesses.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/db.mjs start --quiet && next dev",
    "build": "next build",
    "start": "next start",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset && node scripts/setup.mjs",
    "db:migrate": "prisma migrate deploy && node scripts/db.mjs grant",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "chrono-node": "2.10.1",
    "date-fns": "4.4.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
